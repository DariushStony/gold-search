# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 90
trim_trailing_whitespace = true

# Persian docs and evidence keep their own line breaks; long table rows are normal there.
[*.{md,csv,jsonl}]
max_line_length = 0
trim_trailing_whitespace = false

# Machine-written file: editors must not "fix" it on save (pnpm owns it).
[pnpm-lock.yaml]
insert_final_newline = unset
trim_trailing_whitespace = unset

[COMMIT_EDITMSG]
max_line_length = 0
