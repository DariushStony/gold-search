{
  "name": "gold-search",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "node scripts/dev.ts",
    "demo": "node scripts/build-web.ts && node --env-file-if-exists=.env src/app/server.ts",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "node scripts/build-web.ts",
    "build:server": "esbuild src/app/server.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.js --log-level=warning",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --config configs/knip.json",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test",
    "eval": "node eval/ev-mat.ts && node eval/ev-prm.ts && node eval/ev-ext.ts && node eval/ev-qry.ts",
    "snapshot": "node src/domains/collection/build-snapshot.ts",
    "snapshot:release": "cp data/snapshots/latest.sqlite deploy/snapshot.sqlite && git add deploy/snapshot.sqlite && git -c user.name=\"Dariush Hadipour\" -c user.email=dariushhadi87@gmail.com commit -m \"data: update the demo snapshot\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.9.1"
}
