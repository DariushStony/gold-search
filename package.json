{
  "name": "gold-search",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "demo": "node --env-file-if-exists=.env src/server/app.ts",
    "snapshot": "node src/pipeline/build-snapshot.ts",
    "deploy": "pnpm dlx vercel@latest deploy --prod"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.9.1"
}
