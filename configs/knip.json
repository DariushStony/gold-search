{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/web/scripts/main.ts",
    "src/web/scripts/theme-init.ts",
    "src/web/scripts/atlas.ts",
    "scripts/*.ts",
    "scripts/atlas/extract-diagram.ts",
    "eval/*.ts",
    "test/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "eval/**/*.ts",
    "test/**/*.ts",
    "configs/*.js"
  ],
  "commitlint": {
    "config": ["configs/commitlint.config.js"]
  },
  "lint-staged": {
    "config": ["configs/lintstagedrc.json"]
  },
  "ignoreExportsUsedInFile": false
}
