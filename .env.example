# Copy to .env for `pnpm demo`. Every key is optional; the defaults are shown.
# Read in one place: src/core/env.ts.

# Port the demo listens on.
PORT=4321

# Snapshot the server reads. Default: data/snapshots/latest.sqlite.
# The container uses /app/deploy/snapshot.sqlite.
SNAPSHOT_PATH=

# AI sentence reading (ADR-0005). Without a key, only the rules read the sentence.
# Get a key at https://chat.avalai.ir/platform/api-keys. Never commit it.
AVALAI_API_KEY=
AVALAI_MODEL=gpt-4.1-mini

# Where analytics events go. Default: data/events/events.jsonl. "-" sends them to stdout.
EVENTS_FILE=

# 1 behind a proxy (Hamravesh ingress): the client is the first X-Forwarded-For entry.
TRUST_PROXY=0

# ADR-0013: in production (NODE_ENV=production) the server collects at 10:15 and 18:15 Tehran time. "off" stops it.
COLLECT=
# Where a server run keeps its raw files and new snapshots. Default: a zarsanj folder in the system temp folder.
COLLECT_DIR=
