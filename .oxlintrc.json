{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["data/**", "dist/**", "spikes/**", ".private/**", ".vercel/**"],
  "rules": {
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off"
  }
}
